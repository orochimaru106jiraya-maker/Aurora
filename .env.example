# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================================
# COSMIC KI BADDIE (PROJECT AURORA) — DISCORD BOT ENVIRONMENT CONFIGURATION
# ============================================================================
# Required Discord Bot Token from Discord Developer Portal -> Bot -> Token
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Optional Application ID and Development Guild ID for instant Guild Command Sync
DISCORD_APPLICATION_ID="123456789012345678"
DISCORD_TEST_GUILD_ID=""

# SQLite Database Path (Use /data/cosmic_baddie.db on Railway with a Persistent Volume mounted at /data)
DATABASE_PATH="data/cosmic_baddie.db"

# Bot Owner Discord User ID (Protected in RBAC from privilege modification)
BOT_OWNER_ID="987654321098765432"

# Default Prefix for hybrid/legacy commands (Primary interface is Slash Commands)
DEFAULT_PREFIX="!"

# Optional Local LLM Endpoint (Mode B for /ai assistant - e.g. Ollama / LocalAI / Llama.cpp)
# Leave blank to run Mode A (Zero-dependency deterministic local intent & knowledge base engine)
LOCAL_LLM_ENDPOINT=""
LOCAL_LLM_MODEL="llama3.2:1b"

# Logging and Diagnostics
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/cosmic_baddie.log"
FFMPEG_PATH="ffmpeg"
